        max_life = 592.6;
        mana = 87.1;
		max_mana = 87.1;
	}
	[attack]
	{
		damage_max = 409.7;
		damage_min = 292.9;
	}
	[defend] { defense=672; }
   	[inventory]
	{
    	[pcontent]
		{
			[oneof*]
			{
