[t:template,n:2W_googore_base]  // = 2W_googore
{
	doc = "2W_googore";
	specializes = actor_evil;
    category_name = "2W_evil_d";

	[actor]
	{
		race	= other;

		[skills]
		{
			strength =  	31.4, 0;
			intelligence =  8.9, 0;
			dexterity =  	15.4, 0;
			melee =  		82, 0;
		}
	}

	[aspect]
	{
		draw_shadow 		= false;
		model				= m_c_edm_gg_pos_1;
		experience_value	= 170000;
		life				= 2692.4;
		max_life			= 2692.4;
		mana				= 20.2;
		max_mana			= 20.2;
		[voice]
		{
			[enemy_spotted]	{ priority = high; * = s_e_call_googore_SED;  }
		}
	}

	[attack]
	{
		attack_range	= 0.5;
		damage_min		= 291.5;
		damage_max		= 400.8;
		damage_bonus_min_cmagic = 157;
		damage_bonus_max_cmagic = 203;
	}

	[body]
	{
		avg_move_velocity = 1.0;
        [bone_translator]
		{
			 kill_bone			= bone16;
			 weapon_bone		= bone07;
			 shield_bone		= bone07;
			 body_anterior		= bone07;
			 body_mid			= bone16;
			 body_posterior		= bone01;
		}
		[chore_dictionary]
		{
			chore_prefix = a_c_edm_gg_fs;

			[chore_attack]
			{
				skrit = select_attack;
				chore_stances = 0;

				anim_files:00 = at;
			}
			[chore_magic]
			{
				skrit = select_attack;
				chore_stances = 0;

				anim_files:00 = at-02;
			}
			[chore_die]
			{
				skrit = select_transition;
				chore_stances = 0;

				anim_files:00 = di;
			}

			[chore_default]
			{
				skrit = infinite_loop;
				chore_stances = 0;

				anim_files:00 = dfs;
			}
			[chore_misc]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files]
				{
					slep = ds;
					wake = rv;
				}
			}
			[chore_fidget]
			{
				skrit = select_fidget;
				chore_stances = 0;

				anim_files:00 = dff;
			}

			[chore_walk]
			{
				skrit = select_walk;
				chore_stances = 0;

				anim_files:00 = rv;
			}
		}
	}
	[generator_in_object]
	{
		child_template_name = hole_cav_01;
		spawn_event = WE_ENEMY_SPOTTED;
		spawn_chance = 1.0;
		spawn_delay = 0.5;
		fade_kid = true;
	}
    [inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=spell_googore_spit; }
	}
	[common]
	{
		screen_name="Googore";
		membership=monster,immune_freeze;
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script("googore_goo");
				condition* = receive_world_message("we_anim_sfx",1);
			}

			[*]
			{
				action* = call_sfx_script("googore_goo");
				condition* = receive_world_message("we_anim_die");
			}
		}
	}
	[defend] { defense=787.5; }
	[mind]
	{
		actor_weapon_preference					= WP_MAGIC;
		actor_auto_switches_to_magic			= true;
		actor_auto_switches_to_karate			= true;
		actor_auto_switches_to_melee			= true;

		jat_startup 							= world\ai\jobs\common\job_startup_reveal.skrit
			?invisible 							= true;

		jat_die 								= world\ai\jobs\actors\evil\job_die_delete.skrit;

		jat_flee_from_object					= jat_none;
		jat_guard         						= jat_none;
		jat_move          						= jat_none;
		jat_patrol         						= jat_none;

		on_enemy_entered_icz_switch_to_melee	= true;

		actor_auto_fidgets 						= false;
		movement_orders							= mo_hold;
		inner_comfort_zone_range				= 1.9;
		melee_engage_range 						= 2.0;
		personal_space_range					= 1.5;
		ranged_engage_range 					= 14.0;
		sight_range								= 14.0;
		sight_origin_height						= 2;
	}

}

[t:template,n:2W_c24_3_googore]
{
    specializes = 2W_googore_base;

    [inventory]
    {
   		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=c24_3_spell_googore_spit; }
    }

    // stats & loot from 2W_rector, EDITED
	[actor]
	{
		[skills]
		{
			strength =  	42, 0;
			intelligence =  10.2, 0;
			dexterity =  	4.5, 0;
            combat_magic =  58,  0;  // unchanged
            melee =  58,  0;  // added
		}
	}
	[aspect]
	{
		experience_value = 29260;  // unchanged
        mana = 140;
        max_mana = 140;
        // was 410 - they need to feel more bulky
		life = 1000;
        max_life = 1000;
	}
	[attack]
	{
		damage_max = 198;
		damage_min = 126;
		damage_bonus_min_cmagic = 138;
		damage_bonus_max_cmagic = 218;
	}
	[defend] { defense=256.7; }
	[inventory]
	{
    	[pcontent]
		{
			[oneof*]
			{
            	[oneof*]
				{
					chance = 0.1;
					il_main = #ring/109-181;
				}
				[oneof*]
				{
	            	chance = 0.004;
	            	il_main = #weapon/-rare(1)/172-253;
	                il_main = #armor/-rare(1)/180-660;
                    il_main = #*/-rare(1)/172-253;
                }
			}
		}
	}
}


[t:template,n:2W_dsx_grub_base]  // = 2W_dsx_grub
{
  doc = "2W_dsx_grub";
  specializes = actor_evil;
  category_name = "2W_evil_d";
  [actor]
    {
      race	= other;

      [skills]
	{
	  strength =  	  17.6, 0;
	  intelligence =  6.9, 0;
	  dexterity =  	  8.4, 0;
	  melee =  	  43, 0;
	}
    }
  [aspect]
    {
      model			= m_c_edm_gb_pos_1;
      experience_value	        = 8088;
      life			= 387;
      max_life			= 387;
      mana                      = 0;
      max_mana                  = 0;
      material = flesh;
      [voice]
	{
	  [die] { * = s_e_die_grub_SED; }
	  [attack] { * = s_e_attack_grub_SED; }
	}
    }
  [attack]
    {
      damage_min		= 193.5;
      damage_max		= 614.9;
      attack_range	        = 0.5;
    }

  [body]
    {
      avg_move_velocity = 1.0;
      [bone_translator]
	{
	  kill_bone			= bone01;
	  weapon_bone		= spine_1;
	  shield_bone		= spine_1;
	  body_anterior		= spine_1;
	  body_mid			= spine_3;
	  body_posterior		= spine_5;
	}
      [chore_dictionary]
	{
	  chore_prefix = a_c_edm_gb_fs;

	  [chore_attack]
	    {
	      skrit = select_attack;
	      chore_stances = 0;
				[anim_files]
				{
					//00 = at; - commented out - this attack animation doesn't play a sound, for some reason...
					00 = at-02; 
				}
	    }

	  [chore_die]
	    {
	      skrit = select_transition;
	      chore_stances = 0;

	    anim_files:00 = di;
	    }

	  [chore_default]
	    {
	      skrit = infinite_loop;
	      chore_stances = 0;

	    anim_files:00 = dfs;
	    }

	  [chore_fidget]
	    {
	      skrit = select_fidget;
	      chore_stances = 0;

	    anim_files:00 = dff;
	    anim_files:01 = dff-02;
	    }

	  [chore_walk]
	    {
	      skrit = select_walk;
	      chore_stances = 0;

	    anim_files:00 = wl;
	    anim_files:01 = wl-02;
	    }
	}
    }
  [common] { screen_name = "Ice Grub"; }
  [defend] { defense = 487.3; }
  [mind]
    {
      jat_fidget	= world\ai\jobs\common\job_fidget.skrit;
		
      melee_engage_range  	= 14;
      personal_space_range	= 0.7;
      ranged_engage_range 	= 14.0;
      sight_range				= 14.0;
    }
  [physics]
    {
      explode_when_killed = true;
      break_effect = blood_mist;
      break_sound = s_e_meat_explosion;
      [break_particulate]
	{
	  frag_glb_googore_grub_01 = 1;
	  frag_glb_googore_grub_02 = 1;
	  frag_glb_googore_grub_03 = 1;
	  frag_glb_googore_grub_04 = 1;
	  frag_glb_googore_grub_05 = 1;
	}
    }
}

[t:template,n:2W_c24_3_grub]
{
    specializes = 2W_dsx_grub_base;

    [common] { screen_name = "Grub"; }
}


[t:template,n:2W_mine_worm_base]  // = 2W_mine_worm
{
	category_name = "2W_evil_d";
	doc = "2W_mine_worm";
	specializes = actor_evil;
	[actor]
	{
		[skills]
		{
			strength =  52.8, 0;
			intelligence =  2.9, 0;
			dexterity =  10.7, 0;
			ranged =  65,  0;
		}
	}
	[aspect]
	{
		draw_shadow = false;
		experience_value = 28967;
		life = 972.8;
		max_life = 972.8;
		max_mana = 64;
		mana = 64;
		model = m_c_edm_mw_pos_1;
		[voice]
		{
			[cast]			{ * = s_e_attack_mine_worm;		}
			[die]			{ priority = high; * = s_e_die_worm;				}
			[enemy_spotted]	{ priority = high; * = s_e_call_worm_SED;		}
			[hit_glance]	{ priority = low; * = s_e_hit_worm_SED;			}
		}
	}
	[attack]
	{
		attack_range = 4;
		damage_max = 415.4;
		damage_min = 265;
		damage_bonus_min_cmagic = 107;
		damage_bonus_max_cmagic = 143;
	}
	[body]
	{
		avg_move_velocity = 0;
		[bone_translator]
		{
			body_anterior = bone04;
			body_mid = bone03;
			body_posterior = bone02;
			kill_bone = bone03;
			shield_bone = bone03;
			weapon_bone = AP_flame;
		}
		[chore_dictionary]
		{
			initial_chore = chore_none;
			chore_prefix = a_c_edm_mw_fs;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files]
				{
					00=at;
					01=at-02;
				}
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files] { 00=ds; }
			}
			[chore_misc]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files]
				{
					slep = ds;
					wake = rv;
				}
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files] { 00=di; }
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files] { 00=dff; }
			}
			[chore_magic]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files] { 00=mg; }
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = select_walk;
				[anim_files] { 00=dsf; }
			}
		}
	}
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=spell_mine_worm_spikes; }
	}
	[common]
	{
		screen_name="Mine Worm";
		membership=monster,immune_freeze;
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script("mine_worm_dust");
				condition* = receive_world_message("we_anim_sfx",1);
			}

			[*]
			{
				action* = call_sfx_script("mine_worm_die_dust");
				condition* = receive_world_message("we_anim_die");
			}
		}

	}
	[generator_in_object]
	{
		child_template_name = hole_cav_01;
		spawn_event = WE_ENEMY_SPOTTED;
		spawn_chance = 1.0;
		spawn_delay = 0.5;
		fade_kid = true;
	}
    [defend] { defense=663.5; }
   	[inventory]
	{
    	[pcontent]
		{
			[oneof*]
			{
				chance = 0.2;
				il_main = #*/133-163;
			}
		}
	}
	[mind]
	{
		jat_die 								= world\ai\jobs\actors\evil\job_die_delete.skrit;
		jat_startup 							= world\ai\jobs\common\job_startup_reveal.skrit
			?invisible 							= true;

		jat_flee_from_object					= jat_none;
		jat_guard         						= jat_none;
		jat_move          						= jat_none;
		jat_patrol         						= jat_none;

		on_enemy_entered_icz_switch_to_melee	= true;

		actor_weapon_preference					= WP_MAGIC;
		actor_auto_switches_to_magic			= true;
		actor_auto_switches_to_karate			= true;
		actor_auto_switches_to_melee			= true;

		actor_auto_fidgets 						= false;
		movement_orders 						= mo_hold;
		inner_comfort_zone_range 				= 4.4;
		melee_engage_range 						= 4.5;
		personal_space_range 					= 2.0;
		on_enemy_entered_ocz_attack 			= true;
		ranged_engage_range 					= 10.0;
		sight_range 							= 14.0;
		sight_origin_height						= 2;
	}
}

