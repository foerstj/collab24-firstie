[t:template,n:2W_dsx_jungle_slinger_boss_base]  // = 2W_dsx_jungle_slinger_boss
{
	category_name = "2W_evil_d";
	doc = "2W_dsx_jungle_slinger_boss";
	specializes = 2W_dsx_jungle_slinger_base;
	[actor]
	{
		[skills]
		{
			strength 		=  28.6, 0;
			intelligence 	=  10.8, 0;
			dexterity 		=  17.6, 0;
			ranged 			=  47, 0;
			combat_magic	=  47, 0;
			nature_magic	=  47, 0;
		}
	}
	[aspect]
	{
		scale_base = 1.6;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 192.5;
		damage_min = 126;
		damage_bonus_min_cmagic = 108;
		damage_bonus_max_cmagic = 165;
	}
	[common]
	{
		screen_name = "Jungle Slinger Camora";
    		membership = monster,immune_charm,immune_control,immune_freeze,immune_polymorph,immune_align_change,immune_explode; 	
		[template_triggers]
		{
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits = true;
				action* = call_sfx_script("unique_ray_purple"); // Placeholder
			}

		}
	}
	[defend] { defense=329; }
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=dsx_spell_jungle_slinger_boss; }
		
		[pcontent]
		{
			/* Generated: Tue Jun 17 11:13:15 2003
			Level 7, Special */
			[all*]
			{
				[gold*]
				{
					chance = 0.2;
					min = 31899;
					max = 63088;
				}
				[oneof*]
				{
					il_main = amulet_ilorn;
				}
				[oneof*]
				{
					chance = 0.088888888888889;
					il_main = potion_mana_large;
					il_main = potion_health_large;
				}
				[oneof*]
				{
					il_main = #weapon/129-142;
					il_main = #armor/56-371;
					il_main = #*/129-142;
				}
				[oneof*]
				{
					il_main = #weapon/-rare(1)/142-193;
					il_main = #armor/-rare(1)/105-497;
					il_main = #*/-rare(1)/142-193;
				}
			}
		}
	}
}

