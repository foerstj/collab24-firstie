[t:template,n:2W_dsx_jungle_slinger_base2]  // = 2W_dsx_jungle_slinger
{
	category_name = "2W_evil_d";
	doc = "2W_dsx_jungle_slinger";
	specializes = 2W_dsx_jungle_slinger_base;
	[actor]
	{
		[skills]
		{
			strength 	=  25.7, 0;
			intelligence 	=  9.5, 0;
			dexterity 	=  15.6, 0;
			ranged 		=  46, 0;
			combat_magic	=  46, 0;
			nature_magic	=  46, 0;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 115.5;
		damage_min = 63;
		damage_bonus_min_cmagic = 124;
		damage_bonus_max_cmagic = 112;
	}
	[common]
	{
		screen_name = "Jungle Slinger";
	}
	[defend] { defense=186.7; }
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=dsx_spell_jungle_slinger; }
		[pcontent]
	{
	/* Generated: Tue Jun 17 11:13:15 2003
		Level 7, Weak */
		[oneof*]
		{
			[gold*]
			{
				chance = 0.2;
				min = 31899;
				max = 63088;
			}
			[oneof*]
			{
				chance = 0.088888888888889;
				il_main = potion_mana_large;
				il_main = potion_health_large;
			}
			[oneof*]
			{
				chance = 0.1;
				il_main = #weapon/90-129;
				il_main = #armor/35-301;
				il_main = #*/90-129;
			}
			[oneof*]
			{
				chance = 0.005;
				il_main = #weapon/-rare(1)/58-142;
				il_main = #armor/-rare(1)/0-301;
				il_main = #*/-rare(1)/58-142;
			}
			
		}
	}
	}
}

