[t:template,n:2W_c24_3_barrel_glb_floating_03_gypsy_loot]
{
    specializes = barrel_glb_floating_03_base;

    // from 2W_crate_ice_01_path2nt, increased
	[inventory]
	{
		[pcontent]
		{
			[all*]
			{
				[gold*]
				{
					chance = 0.5;  // was 0.2
					max = 15938;
					min = 7969;
				}
				[oneof*]
				{
                    //chance = 0.3;
					il_main = #weapon/67-157;
					il_main = #armor/112-355;
					il_main = #*/67-157;
					il_main = potion_mana_large;
					il_main = potion_health_large;
				}
			}
		}
	}
}

