		{
			strength =  20.8, 0;
			intelligence =  5.6, 0;
			dexterity =  15.7, 0;
            melee =  66,  0;
		}
	}
	[aspect]
	{
		experience_value = 48438;
		life = 1108.1;
        max_life = 1108.1;
        mana = 32.5;
		max_mana = 32.5;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 241.1;
		damage_min = 182.6;
	}
	[common] { screen_name="Slarg"; }
    [defend] { defense=290.9; }
