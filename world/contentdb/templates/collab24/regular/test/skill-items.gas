[t:template,n:c24_3_base_skill_item]
{
	specializes = xp_base_expitem;

	[common]
	{
		[template_triggers]
		{
			[*]
			{
				action* = call_sfx_script( "combat_spell_sparkle" );
				condition* = receive_world_message("WE_REQ_ACTIVATE");
			}
		}
	}
}

[t:template,n:c24_3_skill_item_melee]
{
	specializes = c24_3_base_skill_item;

	doc = "Melee Experience giving item";
	[common]
	{
		screen_name = "Melee Award";
	}
	[aspect]
	{
		textures:0 = b_i_glb_book-lore-02;
	}
	[attack]
	{
		skill_class = melee;		
	}
	[dsxp_experience_award]
	{
		melee_stat	= 10;
		ranged_stat	= 0;
		cmagic_stat	= 0;
		nmagic_stat	= 0;
		int_stat	= 0.90;
		dex_stat	= 2.70;
		str_stat	= 6.40;
	}
}

