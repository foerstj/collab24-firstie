[t:template,n:c24_3_ctn_01_crystlayer]
{
	specializes = base_pot_cav_03;

	category_name = "path2dm";
	doc = "1W_barrel_cav_01_path2dm";

	// from barrel_cav_01_path2dm
	[attack]
	{
		damage_max = 25;
		damage_min = 13;
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				[gold*]
				{
					chance = 0.2;
					max = 20;
					min = 12;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = potion_mana_small;
					il_main = potion_health_small;
				}
				[oneof*]
				{
					chance = 0.25;
					il_main = potion_mana_small;
					il_main = potion_health_small;
				}
			}
		}
	}
	[trapped]
	{
		trap = trp_generator_arrow_barrel;
	}
}

