[t:template,n:c24_3_barrel_glb_floating_03_gypsy_loot]
{
    specializes = barrel_glb_floating_03_base;

    // from crate_ice_01_path2nt, increased
	[inventory]
	{
		[pcontent]
		{
			[all*]
			{
				[gold*]
				{
					chance = 0.5;
					max = 100;
					min = 75;
				}
				[oneof*]
				{
					il_main = #weapon/12-28;
					il_main = #armor/19-60;
					il_main = #*/12-28;
					il_main = potion_mana_small;
					il_main = potion_health_small;
				}
			}
		}
	}
}

