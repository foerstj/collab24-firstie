[t:template,n:3W_syrrus_base]  // = 3W_syrrus
{
	category_name = "3W_evil_d";
	doc = "3W_syrrus";
	specializes = actor_evil;
	[actor]
	{
		[skills]
		{
			strength =  	71.2, 0;
			intelligence =  16.7, 0;
			dexterity =  	41, 0;
			melee =  		97,  0;
		}
	}
	[aspect]
	{
		draw_shadow = false;
		experience_value = 1663105;
		life = 2912;
		max_life = 2912;
		mana = 57.8;
		max_mana = 57.8;
		model = m_c_edm_hy_pos_1;
		[textures] { 0=b_c_edm_syr; }
		[voice]
		{
			[die]			{ priority = high; * = s_e_die_syrrus; }

		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 559.3;
		damage_min = 374.4;
		damage_bonus_min_cmagic = 340;
		damage_bonus_max_cmagic = 447;
	}
	[body]
	{
		avg_move_velocity = 0.000000;
		[bone_translator]
		{
			body_anterior = headbone;
			body_mid = neckbone05;
			body_posterior = neckbone02;
			kill_bone = neckbone05;
			shield_bone = jawfin;
			weapon_bone = jawbone;
		}
		[chore_dictionary]
		{
			initial_chore = chore_none;
			chore_prefix = a_c_edm_hy_fs;
			[chore_attack]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files] { 00=at; }
			}
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files] { 00=ds; }
			}
			[chore_die]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files] { 00=di; }
			}
			[chore_misc]
			{
				chore_stances = 0;
				skrit = select_transition;
				[anim_files]
				{
					slep = ds;
					wake = rv;
				}
			}
			[chore_magic]
			{
				chore_stances = 0;
				skrit = select_attack;
				[anim_files] { 00=at; }
			}
			[chore_fidget]
			{
				chore_stances = 0;
				skrit = select_fidget;
				[anim_files] { 00=dff; }
			}
			[chore_walk]
			{
				chore_stances = 0;
				skrit = select_walk;
				[anim_files] { 00=rv; }
			}
		}
	}
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=spell_syrrus_fire; }
	}
	[common] 
	{ 
		screen_name="Syrrus"; 
		membership=monster,immune_freeze;
	}
	[defend] { defense=837.8; }
	[inventory]
	{
    	[pcontent]
		{
			[oneof*]
			{
				chance = 0.2;
				il_main = #*/224-297;
			}
		}
	}
	[mind]
	{
		jat_die 						= world\ai\jobs\actors\evil\job_die_delete.skrit;
		jat_startup 							= world\ai\jobs\common\job_startup_reveal.skrit
			?invisible 							= true;
		                            	
		jat_flee_from_object			= jat_none;
		jat_guard         				= jat_none;
		jat_move          				= jat_none;
		jat_patrol         				= jat_none;
		
		actor_weapon_preference			= WP_MAGIC;
		actor_auto_switches_to_magic	= true;
		actor_auto_switches_to_karate	= false;
		actor_auto_switches_to_melee	= false;

		actor_auto_fidgets 				= false;
		movement_orders 				= mo_hold;
		melee_engage_range 				= 10;
		personal_space_range 			= 0.7;
		ranged_engage_range 			= 10.0;
		sight_range 					= 10.0;
		sight_origin_height				= 3;
	}
}

