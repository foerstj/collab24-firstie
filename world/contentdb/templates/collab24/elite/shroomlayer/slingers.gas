[t:template,n:3W_dsx_jungle_slinger_base2]  // = 3W_dsx_jungle_slinger
{
	category_name = "3W_evil_d";
	doc = "3W_dsx_jungle_slinger";
	specializes = 3W_dsx_jungle_slinger_base;
	[actor]
	{
		[skills]
		{
			strength 	=  36.8, 0;
			intelligence 	=  11.1, 0;
			dexterity 	=  20.7, 0;
			ranged 		=  74, 0;
			combat_magic	=  74, 0;
			nature_magic	=  74, 0;
		}
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 181.5;
		damage_min = 99;
		damage_bonus_min_cmagic = 207;
		damage_bonus_max_cmagic = 187;
	}
	[common]
	{
		screen_name = "Jungle Slinger";
	}
	[defend] { defense=293.3; }
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=dsx_spell_jungle_slinger; }
		[pcontent]
	{
	/* Generated: Tue Jun 17 11:13:15 2003
		Level 7, Weak */
		[oneof*]
		{
			[gold*]
			{
				chance = 0.2;
				min = 159286;
				max = 315032;
			}
			[oneof*]
			{
				chance = 0.088888888888889;
				il_main = potion_mana_super;
				il_main = potion_health_super;
			}
			[oneof*]
			{
				chance = 0.1;
				il_main = #weapon/141-201;
				il_main = #armor/55-473;
				il_main = #*/141-201;
			}
			[oneof*]
			{
				chance = 0.005;
				il_main = #weapon/-rare(1)/91-222;
				il_main = #armor/-rare(1)/0-473;
				il_main = #*/-rare(1)/91-222;
			}
			
		}
	}
	}
}

