[t:template,n:3W_dsx_jungle_slinger_boss_base]  // = 3W_dsx_jungle_slinger_boss
{
	category_name = "3W_evil_d";
	doc = "3W_dsx_jungle_slinger_boss";
	specializes = 3W_dsx_jungle_slinger_base;
	[actor]
	{
		[skills]
		{
			strength 		=  40.9, 0;
			intelligence 	=  12.7, 0;
			dexterity 		=  23.3, 0;
			ranged 			=  75, 0;
			combat_magic	=  75, 0;
			nature_magic	=  75, 0;
		}
	}
	[aspect]
	{
		scale_base = 1.6;
	}
	[attack]
	{
		attack_range = 0.5;
		damage_max = 302.5;
		damage_min = 198;
		damage_bonus_min_cmagic = 180;
		damage_bonus_max_cmagic = 275;
	}
	[common]
	{
		screen_name = "Jungle Slinger Camora";
    		membership = monster,immune_charm,immune_control,immune_freeze,immune_polymorph,immune_align_change,immune_explode; 	
		[template_triggers]
		{
			[*]
			{
				condition* = receive_world_message("WE_ENTERED_WORLD");
				single_shot = true;
				no_trig_bits = true;
				action* = call_sfx_script("unique_ray_purple"); // Placeholder
			}

		}
	}
	[defend] { defense=517; }
	[inventory]
	{
		selected_active_location = il_active_primary_spell;
		[other] { il_active_primary_spell=dsx_spell_jungle_slinger_boss; }
		
		[pcontent]
		{
			/* Generated: Tue Jun 17 11:13:15 2003
			Level 7, Special */
			[all*]
			{
				[gold*]
				{
					chance = 0.2;
					min = 159286;
					max = 315032;
				}
				[oneof*]
				{
					il_main = amulet_ilorn;
				}
				[oneof*]
				{
					chance = 0.088888888888889;
					il_main = potion_mana_super;
					il_main = potion_health_super;
				}
				[oneof*]
				{
					il_main = #weapon/201-222;
					il_main = #armor/88-583;
					il_main = #*/201-222;
				}
				[oneof*]
				{
					il_main = #weapon/-rare(1)/222-302;
					il_main = #armor/-rare(1)/165-781;
					il_main = #*/-rare(1)/222-302;
				}
			}
		}
	}
}

