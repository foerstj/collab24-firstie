	// from 3W_barrel_cav_01_path2dm
	[attack]
	{
		damage_max = 265;
		damage_min = 143;
	}
	[inventory]
	{
		[pcontent]
		{
			[oneof*]
			{
				[gold*]
				{
					chance = 0.2;
					max = 38877;
					min = 15551;
				}
				[oneof*]
				{
					chance = 0.2;
					il_main = potion_mana_large;
					il_main = potion_health_large;
				}
				[oneof*]
				{
					chance = 0.25;
					il_main = potion_mana_super;
					il_main = potion_health_super;
				}
			}
		}
	}
	[trapped]
	{
		trap = trp_generator_arrow_barrel;
	}
}

